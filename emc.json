{
    "enhConfig": {
        "enhKey": "doToggle",
        "spawn": "do-toggle/do-toggle.js",
        "withAttrs": {
            "base": "do-toggle",
            "_base": {
                "mapsTo": "parsedStatements",
                "parser": "parse-pattern-statements",
                "instanceOf": "Array",
                "parserConfig": [
                    {
                        "name": "idWithPropAndEvent",
                        "pattern": "^#(?<targetSpecifier.targetElementId>[^?]+)\\?\\.(?<targetSpecifier.targetProp>\\w+) on (?<localEventType>\\w+)$",
                        "description": "Element ID with prop and explicit event type: #{{id}}?.prop on event",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    },
                    {
                        "name": "idWithProp",
                        "pattern": "^#(?<targetSpecifier.targetElementId>[^?]+)\\?\\.(?<targetSpecifier.targetProp>\\w+)$",
                        "description": "Element ID with prop, default event: #{{id}}?.prop",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    },
                    {
                        "name": "idOnly",
                        "pattern": "^#(?<targetSpecifier.targetElementId>[^?\\s]+)$",
                        "description": "Element ID only, infer property and use default event: #{{id}}",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    },
                    {
                        "name": "propOnEventType",
                        "pattern": "^(?<hostProp>.*) on (?<localEventType>.*)$",
                        "description": "Prop with explicit event type",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    },
                    {
                        "name": "prop",
                        "pattern": "^(?<hostProp>.*)$",
                        "description": "Prop with default event",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    }
                ]
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "hydrate": {
                "ifAllOf": [
                    "parsedStatements",
                    "enhancedElement"
                ]
            }
        }
    }
}
