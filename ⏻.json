{
    "enhConfig": {
        "enhKey": "⏻",
        "spawn": "do-toggle/do-toggle.js",
        "withAttrs": {
            "base": "⏻",
            "_base": {
                "mapsTo": "parsedStatements",
                "parser": "parse-grouped-capture-statements",
                "instanceOf": "Array",
                "parserConfig": [
                    {
                        "name": "propOnEventType",
                        "pattern": "^(?<prop>.*) on (?<localEventType>.*)",
                        "description": "Prop with explicit event type"
                    },
                    {
                        "name": "prop",
                        "pattern": "^(?<prop>.*)",
                        "description": "Prop with default event"
                    }
                ]
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "hydrate": {
                "ifAllOf": [
                    "parsedStatements",
                    "enhancedElement"
                ]
            }
        }
    }
}
